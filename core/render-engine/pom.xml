<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.soundapp.music</groupId>
        <artifactId>music-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>render-engine</artifactId>
    <name>Render Engine</name>
    <description>Trasforma una composizione in audio offline ed esporta il risultato in WAV</description>

    <dependencies>
        <dependency>
            <groupId>com.soundapp.music</groupId>
            <artifactId>audio-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.soundapp.music</groupId>
            <artifactId>composition</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Solo l'API di logging, non un'implementazione: una libreria dice
            cosa vuole loggare, è l'applicazione (app-starter, via Spring
            Boot) a decidere dove finiscono quei messaggi. La versione la
            gestisce il BOM di Spring Boot.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            Solo nei test: un'implementazione che raccolga davvero i messaggi.
            Senza, SLF4J avvisa "No SLF4J providers were found" a ogni build e
            il log.warn di WavRenderer non stampa nulla - quindi il messaggio
            che il test sul sidecar non scrivibile dovrebbe produrre non si
            vedrebbe mai.

            Scope test: non entra nel jar della libreria né nell'immagine. In
            produzione l'implementazione la sceglie l'applicazione (app-starter
            prende lo stesso Logback da spring-boot-starter, così i log nei
            test somigliano a quelli veri). Versione dal BOM di Spring Boot.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
